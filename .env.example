NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# --- Microservices ---
# The Core Application is the only thing that calls these; the browser never
# talks to them directly.
UPLOAD_SERVICE_PORT=4001
UPLOAD_SERVICE_URL=http://localhost:4001
EMAIL_SERVICE_PORT=4002
EMAIL_SERVICE_URL=http://localhost:4002

# Shared secret for service-to-service REST calls (SRS 5.1). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_AUTH_SECRET=replace_with_a_long_random_service_secret

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=leadpulse_dev
DB_NAME_TEST=leadpulse_test
# In AWS, set DATABASE_URL to the RDS connection string and NODE_ENV=production
# instead of the individual DB_* values above.
# DATABASE_URL=postgres://user:pass@your-rds-endpoint:5432/leadpulse

# --- File storage ---
# 'local' writes under ./storage and needs no AWS account — this is the
# default so the project runs end to end on a laptop. Switch to 's3' for the
# AWS deployment; no code changes are required, only these variables.
STORAGE_DRIVER=local
# Leave unset to use <workspace-root>/storage, which every service resolves
# identically. If you do set it, use an ABSOLUTE path — a relative one would
# resolve differently per service since each runs from its own directory.
# LOCAL_STORAGE_PATH=/absolute/path/to/storage
# AWS_REGION=ap-south-1
# S3_BUCKET=leadpulse-uploads
# Credentials come from the ECS task role in AWS; only set these locally.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Auth ---
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret

# --- Email provider (wired in with the Email engine) ---
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# --- Logging ---
LOG_LEVEL=info
